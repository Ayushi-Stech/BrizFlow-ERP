# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string.
# Works with a local Postgres, or a free managed Postgres such as
# Neon, Supabase Postgres, or Render Postgres.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bizflow_erp
# Set to "true" if your provider requires SSL (Neon/Supabase/Render usually do)
DATABASE_SSL=false

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Seed data: password used for all demo accounts created by `npm run db:seed`
SEED_PASSWORD=Passw0rd!
